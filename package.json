{
  "name": "mycalmind",
  "private": true,
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test:core": "npm -w @calmind/core run test -- --run",
    "ios": "npm -w mycalmind-app run ios",
    "start": "npm -w mycalmind-app run start",
    "typecheck": "npm -w mycalmind-app exec tsc -- --noEmit",
    "test": "npm run test:core",
    "deploy:device": "sh tools/deploy-device.sh",
    "dtp": "sh tools/dtp.sh",
    "tdtp": "sh tools/tdtp.sh"
  },
  "version": "1.5.0"
}
